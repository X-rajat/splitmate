<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows plaintext HTTP only to the Android emulator's host-loopback alias,
         so local development against `docker compose up` needs no extra setup.
         Production builds should point API_BASE_URL at an https:// endpoint. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
